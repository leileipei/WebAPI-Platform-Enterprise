          "oas-3.0",
          "oas-3.1"
        ],
        "testIds": [
          "types.integer_number",
          "types.union_null",
          "types.nullable30",
          "types.boolean",
          "schema.types.same"
        ],
        "proofCondition": "登记方言的类型集合包含；integer属于number；boolean空/全集",
        "unknownCondition": "非法方言或未登记类型"
      },
      {
        "id": "schema.enum_const",
        "family": "enum_const",
        "dialects": [
          "oas-3.0",
          "oas-3.1"
        ],
        "testIds": [
          "enum.widen",
          "enum.deep_const",
          "enum.numeric_precision",
          "schema.enum_const.same"
        ],
        "proofCondition": "逐一验证有限枚举和常量的全部允许实例",
        "unknownCondition": "枚举超预算或实例无法完成校验"
      },
      {
