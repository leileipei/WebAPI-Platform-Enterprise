  "catalog": {
    "engineVersion": "compatibility-v2",
    "adapterVersion": "oas-http-model-v2",
    "limits": {
      "maxDocumentBytes": 2097152,
      "maxBundleBytes": 4194304,
      "maxResources": 16,
      "maxDepth": 64,
      "maxNodes": 50000,
