+import {useState} from 'react';
+import {permissionGroups,type Permission} from './permission-display.mjs';
+const columns=[['read','查看'],['configure','创建与配置'],['release','发布与审批'],['manage','管理与操作'],['other','其他权限']];
+export function PermissionMatrix({items,value,readOnly=false,onChange}:{items:Permission[];value:Record<string,any>;readOnly?:boolean;onChange?:(code:string,checked:boolean)=>void}){
+ const [query,setQuery]=useState(''),groups=permissionGroups(items,query),selected=items.filter(p=>value[p.code]).length;
+ const visibleColumns=columns.filter(([key])=>key!=='other'||items.some(p=>permissionGroups([p])[0]?.items[0]?.column==='other'));
+ return <div className="permission-matrix"><div className="permission-toolbar"><label>筛选权限<input aria-label="筛选权限" placeholder="名称、编码、模块或说明" value={query} onKeyDown={e=>{if(e.key==='Enter')e.preventDefault();}} onChange={e=>setQuery(e.target.value)}/></label><span role="status">已选 {selected} / {items.length} 项{query&&` · 筛选显示 ${groups.reduce((n,g)=>n+g.items.length,0)} 项`}</span></div><p className="permission-note">功能权限与用户数据范围共同生效。发布、回滚、审批和管理权限请逐项复核；勾选不会自动增加依赖权限。</p><div className="permission-scroll"><table><caption>权限模块与功能矩阵</caption><thead><tr><th scope="col">模块</th>{visibleColumns.map(([key,title])=><th scope="col" key={key}>{title}</th>)}</tr></thead><tbody>{groups.map(group=><tr key={group.key}><th scope="row"><strong>{group.label}</strong><small>{group.key}</small></th>{visibleColumns.map(([column])=><td key={column}>{group.items.filter(p=>p.column===column).map(p=><label className="permission-choice" key={p.code} title={p.description}><input type="checkbox" aria-label={p.label+' · '+p.code} checked={!!value[p.code]} disabled={readOnly} onChange={e=>onChange?.(p.code,e.target.checked)}/><span>{p.label}<code>{p.code}</code></span></label>)}</td>)}</tr>)}</tbody></table>{!groups.length&&<p className="empty">没有匹配的权限；筛选不会改变已勾选内容。</p>}</div></div>;
+}
